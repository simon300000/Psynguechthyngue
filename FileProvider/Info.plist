<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>
    <key>CFBundleDisplayName</key>
    <string>Psynguechthyngue</string>
    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleIdentifier</key>
    <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>$(PRODUCT_NAME)</string>
    <key>CFBundlePackageType</key>
    <string>XPC!</string>
    <key>CFBundleShortVersionString</key>
    <string>1.0.0</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>PsyAppGroupIdentifier</key>
    <string>$(APP_GROUP_IDENTIFIER)</string>
    <key>PsyKeychainAccessGroup</key>
    <string>$(KEYCHAIN_ACCESS_GROUP)</string>
    <key>NSExtension</key>
    <dict>
        <key>NSExtensionPointIdentifier</key>
        <string>com.apple.fileprovider-nonui</string>
        <key>NSExtensionPrincipalClass</key>
        <string>$(PRODUCT_MODULE_NAME).FileProviderExtension</string>
        <!-- Our "Remove Download" action also drops the Syncthing copy; hide the system's. -->
        <key>NSExtensionFileProviderAllowsUserControlledEviction</key>
        <false/>
        <key>NSExtensionFileProviderDocumentGroup</key>
        <string>$(APP_GROUP_IDENTIFIER)</string>
		<key>NSExtensionFileProviderSupportsEnumeration</key>
		<true/>
		<key>NSExtensionFileProviderSupportsFailingUploadOnConflict</key>
		<true/>
		<key>NSExtensionFileProviderActions</key>
		<array>
			<dict>
				<key>NSExtensionFileProviderActionIdentifier</key>
				<string>app.psynguechthyngue.action.keep-downloaded</string>
				<key>NSExtensionFileProviderActionName</key>
				<string>FILE_PROVIDER_KEEP_DOWNLOADED</string>
				<key>NSExtensionFileProviderActionActivationRule</key>
				<string>SUBQUERY ( fileproviderItems, $fileproviderItem, $fileproviderItem.userInfo.pinned != YES AND $fileproviderItem.userInfo.onDemand == YES ).@count &gt; 0</string>
			</dict>
			<dict>
				<key>NSExtensionFileProviderActionIdentifier</key>
				<string>app.psynguechthyngue.action.remove-download</string>
				<key>NSExtensionFileProviderActionName</key>
				<string>FILE_PROVIDER_REMOVE_DOWNLOAD</string>
				<key>NSExtensionFileProviderActionActivationRule</key>
				<string>SUBQUERY ( fileproviderItems, $fileproviderItem, $fileproviderItem.userInfo.pinned == YES AND $fileproviderItem.userInfo.onDemand == YES ).@count &gt; 0</string>
			</dict>
		</array>
		<!-- Part 9: badge on files kept on this device (on-demand folders). -->
		<key>NSFileProviderDecorations</key>
		<array>
			<dict>
				<key>Identifier</key>
				<string>$(PRODUCT_BUNDLE_IDENTIFIER).keepDownloaded</string>
				<key>BadgeImageType</key>
				<string>$(PRODUCT_BUNDLE_IDENTIFIER).decoration.keep-downloaded</string>
				<key>Category</key>
				<string>Badge</string>
				<key>LocalizedTitle</key>
				<dict>
					<key>NSStringFormat</key>
					<string>FILE_PROVIDER_KEPT_ON_DEVICE</string>
				</dict>
			</dict>
		</array>
	</dict>
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>$(PRODUCT_BUNDLE_IDENTIFIER).decoration.keep-downloaded</string>
			<key>UTTypeDescription</key>
			<string>Kept on this device</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>com.apple.icon-decoration.badge</string>
			</array>
			<key>UTTypeIconFiles</key>
			<array>
				<string>KeepDownloadedBadge</string>
			</array>
			<key>UTTypeIcons</key>
			<dict>
				<key>UTTypeIconName</key>
				<string>KeepDownloadedBadge</string>
				<key>UTTypeIconBadgeName</key>
				<string>KeepDownloadedBadge</string>
			</dict>
		</dict>
	</array>
    <key>NSExtensionFileProviderDownloadPipelineDepth</key>
    <integer>1</integer>
    <key>NSExtensionFileProviderUploadPipelineDepth</key>
    <integer>1</integer>
</dict>
</plist>
