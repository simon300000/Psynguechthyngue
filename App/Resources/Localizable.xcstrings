          }
        }
      }
    },
    "FILES_ERROR_STALE" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This file has changed on other devices. Open Psynguechthyngue to sync."
          }
        },
