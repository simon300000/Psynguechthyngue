{
  "sourceLanguage" : "en",
  "strings" : {
    "%@ of %@ downloaded (%@)" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已下载 %1$@ / %2$@（%3$@）"
          }
        }
      }
    },
    "%lld files in progress" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld 个文件正在传输"
          }
        }
      }
    },
    "On this device" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本机占用"
          }
        }
