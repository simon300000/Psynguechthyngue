+// GlobalFileAvailability returns the non-local configured devices whose
+// persisted index contains the exact current global version of path. Unlike
+// block availability this deliberately does not require a live connection;
+// embedding applications use it to retain version-bound upload evidence while
+// offline.
+func (m *model) GlobalFileAvailability(folder, path string) ([]protocol.DeviceID, error) {
+	m.mut.RLock()
+	defer m.mut.RUnlock()
+
+	cfg, ok := m.folderCfgs[folder]
+	if !ok {
+		return nil, ErrFolderMissing
+	}
+	configured := make(map[protocol.DeviceID]struct{}, len(cfg.Devices))
+	for _, device := range cfg.Devices {
+		if device.DeviceID != protocol.LocalDeviceID {
+			configured[device.DeviceID] = struct{}{}
+		}
+	}
+	devices, err := m.sdb.GetGlobalAvailability(folder, path)
+	if err != nil {
+		return nil, err
+	}
+	result := make([]protocol.DeviceID, 0, len(devices))
+	for _, deviceID := range devices {
+		if _, ok := configured[deviceID]; ok {
+			result = append(result, deviceID)
+		}
+	}
+	return result, nil
