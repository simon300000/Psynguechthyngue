+func TestRemoteIndexProofRotatesOnEveryAuthoritativeClusterConfig(t *testing.T) {
+	wrapper, folder := newDefaultCfgWrapper(t)
+	m := setupModel(t, wrapper)
+	defer cleanupModel(m)
+
+	connection := newFakeConnection(device1, m)
+	m.AddConnection(connection, protocol.Hello{})
+	m.promoteConnections()
+	mustReceiveProofClusterConfig(t, m, connection, folder.ID, 83, 0)
+	first := mustRemoteIndexReadiness(t, m, device1, folder.ID)
+	if first.State != RemoteIndexProofCurrent {
+		t.Fatalf("initial proof state = %v, want current", first.State)
+	}
+
+	// ensureIndexHandler is the first state-changing step of an authoritative
+	// ClusterConfig. It must retire the previous proof before parsing or
+	// applying the new announcement.
+	_, secondEpoch, err := m.ensureIndexHandler(connection)
+	if err != nil {
+		t.Fatal(err)
+	}
+	during := mustRemoteIndexReadiness(t, m, device1, folder.ID)
+	if during.State != RemoteIndexProofMissing || secondEpoch.generation <= first.ConnectionEpoch {
+		t.Fatalf("same-connection ClusterConfig start reused old proof: first=%+v during=%+v epoch=%+v", first, during, secondEpoch)
+	}
+
+	mustReceiveProofClusterConfig(t, m, connection, folder.ID, 83, 0)
+	second := mustRemoteIndexReadiness(t, m, device1, folder.ID)
+	if second.State != RemoteIndexProofCurrent || second.ConnectionEpoch <= secondEpoch.generation {
+		t.Fatalf("successful replacement ClusterConfig did not publish a newer proof: %+v", second)
+	}
+
+	malformed := &protocol.ClusterConfig{Folders: []protocol.Folder{{
+		ID: folder.ID,
+		Devices: []protocol.Device{
+			{ID: myID},
+			// Missing the remote device entry must fail after rotation.
+		},
+	}}}
+	if err := m.ClusterConfig(connection, malformed); err == nil {
+		t.Fatal("malformed replacement ClusterConfig unexpectedly succeeded")
+	}
+	if got := mustRemoteIndexReadiness(t, m, device1, folder.ID); got.State != RemoteIndexProofMissing {
+		t.Fatalf("malformed replacement ClusterConfig retained old proof: %+v", got)
+	}
+}
