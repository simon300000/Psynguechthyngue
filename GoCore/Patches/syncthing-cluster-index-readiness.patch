+// SetLocalContentAvailable publishes source authority only after the exact
+// global version is present as a stable, fully hashed regular file in the
+// configured folder. On-demand copies remain distinguishable from retained
+// copies so a later global version is not pulled implicitly.
+func (m *model) SetLocalContentAvailable(folder, path, expectedVersion string, onDemand bool) error {
+	m.mut.RLock()
+	cfg, ok := m.folderCfgs[folder]
+	m.mut.RUnlock()
+	if !ok {
+		return ErrFolderMissing
+	}
+	global, ok, err := m.sdb.GetGlobalFile(folder, path)
+	if err != nil {
+		return err
+	}
+	if !ok || global.IsDeleted() || global.IsInvalid() || global.IsDirectory() || global.IsSymlink() {
+		return errors.New("global file is not an eligible regular version")
+	}
+	if global.Version.String() != expectedVersion {
+		return errors.New("global file version changed")
+	}
+	filesystem := cfg.Filesystem()
+	info, err := filesystem.Lstat(path)
+	if err != nil || !info.IsRegular() || info.Size() != global.Size {
+		return errors.New("local content is missing or has the wrong size")
+	}
+	blocks, err := scanner.HashFile(
+		context.Background(),
+		folder,
+		filesystem,
+		path,
+		global.BlockSize(),
+		nil,
+	)
+	if err != nil {
+		return err
+	}
+	verified := global
+	verified.Blocks = blocks
+	verified.BlocksHash = nil
+	if !global.BlocksEqual(verified) {
+		return errors.New("local content blocks do not match the global version")
+	}
+	local := global
+	local.LocalFlags = 0
+	if onDemand {
+		local.LocalFlags = protocol.FlagLocalOnDemand
+	}
+	if err := m.sdb.Update(folder, protocol.LocalDeviceID, []protocol.FileInfo{local}); err != nil {
+		return err
+	}
+	sequence, err := m.sdb.GetDeviceSequence(folder, protocol.LocalDeviceID)
+	if err != nil {
+		return err
+	}
+	m.evLogger.Log(events.LocalIndexUpdated, map[string]interface{}{
+		"folder":    folder,
+		"items":     1,
+		"filenames": []string{path},
+		"sequence":  sequence,
+		"version":   sequence,
+	})
+	return nil
+}
