+type RemoteIndexReadinessState uint8
+
+const (
+	RemoteIndexProofMissing RemoteIndexReadinessState = iota
+	RemoteIndexProofPending
+	RemoteIndexProofCurrent
+)
+
+// RemoteIndexReadiness is an in-process snapshot. Connection identity and
+// index metadata are deliberately not JSON API fields.
+type RemoteIndexReadiness struct {
+	State             RemoteIndexReadinessState `json:"-"`
+	ConnectionID      string                    `json:"-"`
+	ConnectionEpoch   uint64                    `json:"-"`
+	AnnouncedIndexID  protocol.IndexID          `json:"-"`
+	AnnouncedSequence int64                     `json:"-"`
+	StoredIndexID     protocol.IndexID          `json:"-"`
+	StoredSequence    int64                     `json:"-"`
+}
+
+type RemoteIndexReadinessProvider interface {
+	RemoteIndexReadiness(device protocol.DeviceID, folder string) (RemoteIndexReadiness, error)
+}
+
+type RemoteIndexEpochProvider interface {
+	RemoteIndexEpochCurrent(device protocol.DeviceID, connectionID string, generation uint64) bool
+}
+
+var (
+	errStaleRemoteIndexEpoch   = errors.New("stale remote index connection epoch")
+	errInvalidRemoteIndexEpoch = errors.New("remote index proof is invalid for this connection epoch")
+)
+
+type remoteIndexEpoch struct {
+	device       protocol.DeviceID
+	connectionID string
+	generation   uint64
+}
+
+type remoteIndexProofKey struct {
+	device protocol.DeviceID
+	folder string
+}
+
+type remoteIndexProofPair struct {
+	indexID           protocol.IndexID
+	maxSequence       int64
+	fullIndexRequired bool
+	fullIndexReceived bool
+	valid             bool
+}
+
+// remoteIndexProofState serializes current receive-primary proof changes with
+// the corresponding remote-index database mutations. Readers therefore never
+// combine a proof epoch with a database pair from another epoch.
+type remoteIndexProofState struct {
+	mu      sync.RWMutex
+	db      db.DB
+	next    uint64
+	current map[protocol.DeviceID]remoteIndexEpoch
+	proofs  map[remoteIndexProofKey]remoteIndexProofPair
+	// requireFull records a durable reset performed in the current epoch.
+	// It is consumed by publish, after ClusterConfig handling has created the
+	// replacement index handler.
+	requireFull map[remoteIndexProofKey]bool
+	// blocked is a conservative folder lifecycle fence. It survives every
+	// same-connection ClusterConfig rotation and is cleared only by a fresh
+	// connection epoch.
+	blocked map[remoteIndexProofKey]bool
+	// poisoned records a malformed or failed receive frame. It also survives
+	// same-connection ClusterConfig rotation: only a fresh connection may
+	// establish a new trustworthy receive stream for this folder.
+	poisoned map[remoteIndexProofKey]bool
+}
+
+func newRemoteIndexProofState(database db.DB) *remoteIndexProofState {
+	return &remoteIndexProofState{
+		db:          database,
+		current:     make(map[protocol.DeviceID]remoteIndexEpoch),
+		proofs:      make(map[remoteIndexProofKey]remoteIndexProofPair),
+		requireFull: make(map[remoteIndexProofKey]bool),
+		blocked:     make(map[remoteIndexProofKey]bool),
+		poisoned:    make(map[remoteIndexProofKey]bool),
+	}
+}
+
+func (s *remoteIndexProofState) begin(device protocol.DeviceID, connectionID string) remoteIndexEpoch {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	s.next++
+	epoch := remoteIndexEpoch{device: device, connectionID: connectionID, generation: s.next}
+	s.current[device] = epoch
+	s.clearDeviceLocked(device)
+	return epoch
+}
+
+func (s *remoteIndexProofState) rotate(epoch remoteIndexEpoch) (remoteIndexEpoch, bool) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	if s.current[epoch.device] != epoch {
+		return remoteIndexEpoch{}, false
+	}
+	s.next++
+	replacement := remoteIndexEpoch{device: epoch.device, connectionID: epoch.connectionID, generation: s.next}
+	s.current[epoch.device] = replacement
+	s.clearEpochLocked(epoch.device)
+	return replacement, true
+}
+
+func (s *remoteIndexProofState) invalidate(epoch remoteIndexEpoch) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	if s.current[epoch.device] != epoch {
+		return
+	}
+	delete(s.current, epoch.device)
+	s.clearDeviceLocked(epoch.device)
+}
+
+func (s *remoteIndexProofState) withEpoch(epoch remoteIndexEpoch, operation func() error) error {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	if s.current[epoch.device] != epoch {
+		return errStaleRemoteIndexEpoch
+	}
+	return operation()
+}
+
+func (s *remoteIndexProofState) reset(epoch remoteIndexEpoch, folder string, requireFull bool, operation func() error) error {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	if s.current[epoch.device] != epoch {
+		return errStaleRemoteIndexEpoch
+	}
+	key := remoteIndexProofKey{device: epoch.device, folder: folder}
+	if s.poisoned[key] {
+		return errInvalidRemoteIndexEpoch
+	}
+	delete(s.proofs, key)
+	if err := operation(); err != nil {
+		s.poisoned[key] = true
+		return err
+	}
+	if requireFull {
+		s.requireFull[key] = true
+	} else {
+		delete(s.requireFull, key)
+	}
+	return nil
+}
+
+func (s *remoteIndexProofState) clearFolder(epoch remoteIndexEpoch, folder string) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	if s.current[epoch.device] != epoch {
+		return
+	}
+	key := remoteIndexProofKey{device: epoch.device, folder: folder}
+	delete(s.proofs, key)
+	delete(s.requireFull, key)
+}
+
+func (s *remoteIndexProofState) blockFolder(epoch remoteIndexEpoch, folder string) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	if s.current[epoch.device] != epoch {
+		return
+	}
+	key := remoteIndexProofKey{device: epoch.device, folder: folder}
+	delete(s.proofs, key)
+	delete(s.requireFull, key)
+	s.blocked[key] = true
+}
+
+func (s *remoteIndexProofState) publish(epoch remoteIndexEpoch, pairs map[string]remoteIndexProofPair) bool {
+	return s.publishAndDo(epoch, pairs, nil)
+}
+
+// publishAndDo validates and publishes one authoritative ClusterConfig epoch,
+// then invokes operation while the epoch lock is still held. This lets callers
+// enqueue private observation evidence before a newer epoch can overtake it.
+func (s *remoteIndexProofState) publishAndDo(epoch remoteIndexEpoch, pairs map[string]remoteIndexProofPair, operation func()) bool {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	if s.current[epoch.device] != epoch {
+		return false
+	}
+	s.clearProofsLocked(epoch.device)
+	for folder, pair := range pairs {
+		if folder == "" || pair.maxSequence < 0 {
+			s.clearProofsLocked(epoch.device)
+			return false
+		}
+		key := remoteIndexProofKey{device: epoch.device, folder: folder}
+		if s.blocked[key] {
+			continue
+		}
+		pair.fullIndexRequired = s.requireFull[key]
+		pair.valid = !s.poisoned[key]
+		s.proofs[key] = pair
+	}
+	if operation != nil {
+		operation()
+	}
+	return true
+}
+
+func (s *remoteIndexProofState) accept(epoch remoteIndexEpoch, folder string, fullIndex bool, frameSequence int64, operation func() (bool, error)) (int64, error) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	if s.current[epoch.device] != epoch {
+		return 0, errStaleRemoteIndexEpoch
+	}
+	key := remoteIndexProofKey{device: epoch.device, folder: folder}
+	pair, pairOK := s.proofs[key]
+	if s.poisoned[key] || !pairOK || !pair.valid {
+		// A malformed or failed frame makes every later frame in this
+		// folder/connection epoch untrustworthy. Reject before invoking the
+		// database operation so a later batch cannot manufacture a durable
+		// cursor that a future ClusterConfig would accept.
+		if !pairOK {
+			s.poisoned[key] = true
+		}
+		return 0, errInvalidRemoteIndexEpoch
+	}
+	frameValid, err := operation()
+	if !frameValid {
+		s.poisonLocked(key, pair, pairOK)
+	}
+	if err != nil {
+		s.poisonLocked(key, pair, pairOK)
+		return 0, err
+	}
+	if !frameValid {
+		return 0, errInvalidRemoteIndexEpoch
+	}
+	storedIndexID, storedSequence, err := s.db.GetIndexIDAndSequence(folder, epoch.device)
+	if err != nil {
+		s.poisonLocked(key, pair, pairOK)
+		return 0, err
+	}
+	if storedSequence != frameSequence {
+		s.poisonLocked(key, pair, pairOK)
+		return storedSequence, errInvalidRemoteIndexEpoch
+	}
+	if fullIndex {
+		pair.fullIndexReceived = true
+	}
+	if pair.valid && (pair.indexID == 0 || pair.indexID == storedIndexID) && storedSequence >= pair.maxSequence {
+		pair.maxSequence = storedSequence
+	}
+	s.proofs[key] = pair
+	return storedSequence, nil
+}
+
+func (s *remoteIndexProofState) readiness(epoch remoteIndexEpoch, folder string) (RemoteIndexReadiness, error) {
+	s.mu.RLock()
+	defer s.mu.RUnlock()
+	if s.current[epoch.device] != epoch {
+		return RemoteIndexReadiness{State: RemoteIndexProofMissing}, nil
+	}
+	pair, pairOK := s.proofs[remoteIndexProofKey{device: epoch.device, folder: folder}]
+	if !pairOK {
+		return RemoteIndexReadiness{State: RemoteIndexProofMissing}, nil
+	}
+	storedIndexID, storedSequence, err := s.db.GetIndexIDAndSequence(folder, epoch.device)
+	if err != nil {
+		return RemoteIndexReadiness{}, err
+	}
+	result := RemoteIndexReadiness{
+		State:             RemoteIndexProofPending,
+		ConnectionID:      epoch.connectionID,
+		ConnectionEpoch:   epoch.generation,
+		AnnouncedIndexID:  pair.indexID,
+		AnnouncedSequence: pair.maxSequence,
+		StoredIndexID:     storedIndexID,
+		StoredSequence:    storedSequence,
+	}
+	if pair.valid && (!pair.fullIndexRequired || pair.fullIndexReceived) && storedSequence == pair.maxSequence && (pair.indexID == 0 || storedIndexID == pair.indexID) {
+		result.State = RemoteIndexProofCurrent
+	}
+	return result, nil
+}
+
+func (s *remoteIndexProofState) epochCurrent(epoch remoteIndexEpoch) bool {
+	s.mu.RLock()
+	defer s.mu.RUnlock()
+	return s.current[epoch.device] == epoch
+}
+
+func (s *remoteIndexProofState) clearDeviceLocked(device protocol.DeviceID) {
+	s.clearEpochLocked(device)
+	for key := range s.blocked {
+		if key.device == device {
+			delete(s.blocked, key)
+		}
+	}
+	for key := range s.poisoned {
+		if key.device == device {
+			delete(s.poisoned, key)
+		}
+	}
+}
+
+func (s *remoteIndexProofState) poisonLocked(key remoteIndexProofKey, pair remoteIndexProofPair, pairOK bool) {
+	s.poisoned[key] = true
+	if pairOK {
+		pair.valid = false
+		s.proofs[key] = pair
+	}
+}
+
+func (s *remoteIndexProofState) clearEpochLocked(device protocol.DeviceID) {
+	s.clearProofsLocked(device)
+	for key := range s.requireFull {
+		if key.device == device {
+			delete(s.requireFull, key)
+		}
+	}
+}
+
+func (s *remoteIndexProofState) clearProofsLocked(device protocol.DeviceID) {
+	for key := range s.proofs {
+		if key.device == device {
+			delete(s.proofs, key)
+		}
+	}
+}
