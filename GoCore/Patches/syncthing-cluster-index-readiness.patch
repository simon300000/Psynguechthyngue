+// GetIndexIDAndSequence reads the remote index identity and its accepted
+// sequence from one SQLite statement, so callers cannot combine values from
+// different index-reset epochs.
+func (s *folderDB) GetIndexIDAndSequence(device protocol.DeviceID) (protocol.IndexID, int64, error) {
+	var result struct {
+		IndexID  string `db:"index_id"`
+		Sequence int64  `db:"sequence"`
+	}
+	err := s.stmt(`
+		SELECT i.index_id, i.sequence FROM indexids i
+		INNER JOIN devices d ON d.idx = i.device_idx
+		WHERE d.device_id = ?
+	`).Get(&result, device.String())
+	if errors.Is(err, sql.ErrNoRows) {
+		return 0, 0, nil
+	}
+	if err != nil {
+		return 0, 0, wrap(err, "select index identity and sequence")
+	}
+	if result.IndexID == "" {
+		return 0, result.Sequence, nil
+	}
+	indexID, err := indexIDFromHex(result.IndexID)
+	return indexID, result.Sequence, wrap(err, "decode index identity")
+}
