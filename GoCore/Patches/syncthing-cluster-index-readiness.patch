+func TestRemoteIndexProofPrePublishPoisonIsConnectionScopedAndFolderIsolated(t *testing.T) {
+	wrapper, folder := newDefaultCfgWrapper(t)
+	m := setupModel(t, wrapper)
+	defer cleanupModel(m)
+
+	const (
+		otherFolder = "proof-isolation"
+		indexID     = protocol.IndexID(113)
+	)
+	for _, folderID := range []string{folder.ID, otherFolder} {
+		if err := m.sdb.SetIndexID(folderID, device1, indexID); err != nil {
+			t.Fatal(err)
+		}
+	}
+
+	proofs := m.remoteIndexProofs
+	epoch := proofs.begin(device1, "prepublish")
+	operationCalled := false
+	if _, err := proofs.accept(epoch, folder.ID, false, 10, func() (bool, error) {
+		operationCalled = true
+		return true, nil
+	}); !errors.Is(err, errInvalidRemoteIndexEpoch) {
+		t.Fatalf("pre-publish frame error = %v, want invalid-epoch sentinel", err)
+	}
+	if operationCalled {
+		t.Fatal("pre-publish frame reached its database operation")
+	}
+
+	pairs := map[string]remoteIndexProofPair{
+		folder.ID:   {indexID: indexID, maxSequence: 10},
+		otherFolder: {indexID: indexID, maxSequence: 0},
+	}
+	if !proofs.publish(epoch, pairs) {
+		t.Fatal("publish unexpectedly rejected current epoch")
+	}
+	if got, err := proofs.readiness(epoch, folder.ID); err != nil || got.State != RemoteIndexProofPending || got.StoredSequence != 0 {
+		t.Fatalf("pre-publish poison did not hold the folder pending: readiness=%+v err=%v", got, err)
+	}
+	if got, err := proofs.readiness(epoch, otherFolder); err != nil || got.State != RemoteIndexProofCurrent {
+		t.Fatalf("folder poison leaked to an unrelated folder: readiness=%+v err=%v", got, err)
+	}
+
+	rotated, ok := proofs.rotate(epoch)
+	if !ok || !proofs.publish(rotated, pairs) {
+		t.Fatal("same-connection rotation unexpectedly failed")
+	}
+	if got, err := proofs.readiness(rotated, folder.ID); err != nil || got.State != RemoteIndexProofPending {
+		t.Fatalf("same-connection rotation cleared pre-publish poison: readiness=%+v err=%v", got, err)
+	}
+	operationCalled = false
+	if err := proofs.reset(rotated, folder.ID, false, func() error {
+		operationCalled = true
+		return nil
+	}); !errors.Is(err, errInvalidRemoteIndexEpoch) {
+		t.Fatalf("poisoned reset error = %v, want invalid-epoch sentinel", err)
+	}
+	if operationCalled {
+		t.Fatal("poisoned reset reached its database operation")
+	}
+
+	fresh := proofs.begin(device1, "fresh")
+	if !proofs.publish(fresh, pairs) {
+		t.Fatal("fresh connection publish unexpectedly failed")
+	}
+	operationCalled = false
+	if _, err := proofs.accept(rotated, folder.ID, false, 10, func() (bool, error) {
+		operationCalled = true
+		return false, nil
+	}); !errors.Is(err, errStaleRemoteIndexEpoch) {
+		t.Fatalf("retired epoch error = %v, want stale-epoch sentinel", err)
+	}
+	if operationCalled {
+		t.Fatal("retired epoch reached its database operation")
+	}
+
+	file := protocol.FileInfo{Name: "fresh", Sequence: 10, Version: protocol.Vector{}.Update(device1.Short())}
+	if _, err := proofs.accept(fresh, folder.ID, false, 10, func() (bool, error) {
+		return true, m.sdb.Update(folder.ID, device1, []protocol.FileInfo{file})
+	}); err != nil {
+		t.Fatal(err)
+	}
+	if got, err := proofs.readiness(fresh, folder.ID); err != nil || got.State != RemoteIndexProofCurrent || got.StoredSequence != 10 {
+		t.Fatalf("fresh connection did not recover poisoned folder: readiness=%+v err=%v", got, err)
+	}
+}
