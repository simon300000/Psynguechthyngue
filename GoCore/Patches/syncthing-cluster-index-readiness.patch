+func TestRemoteIndexProofInvalidatesLostPrimaryWithSecondaryConnected(t *testing.T) {
+	wrapper, folder := newDefaultCfgWrapper(t)
+	m := setupModel(t, wrapper)
+	defer cleanupModel(m)
+
+	primary := newFakeConnection(device1, m)
+	m.AddConnection(primary, protocol.Hello{})
+	m.promoteConnections()
+	mustReceiveProofClusterConfig(t, m, primary, folder.ID, 71, 0)
+	initial := mustRemoteIndexReadiness(t, m, device1, folder.ID)
+	if initial.State != RemoteIndexProofCurrent {
+		t.Fatalf("initial primary proof state = %v, want current", initial.State)
+	}
+
+	secondary := newFakeConnection(device1, m)
+	m.AddConnection(secondary, protocol.Hello{})
+	m.Closed(primary, errors.New("primary lost"))
+	missing := mustRemoteIndexReadiness(t, m, device1, folder.ID)
+	if missing.State != RemoteIndexProofMissing {
+		t.Fatalf("proof survived primary loss with a secondary connected: %+v", missing)
+	}
+
+	m.promoteConnections()
+	mustReceiveProofClusterConfig(t, m, secondary, folder.ID, 71, 0)
+	promoted := mustRemoteIndexReadiness(t, m, device1, folder.ID)
+	if promoted.State != RemoteIndexProofCurrent || promoted.ConnectionID != secondary.ConnectionID() || promoted.ConnectionEpoch <= initial.ConnectionEpoch {
+		t.Fatalf("promoted connection did not publish a newer current proof: old=%+v new=%+v", initial, promoted)
+	}
+}
