 package protocol
 
 import (
+	"errors"
 	"io"
+	"sync"
 	"sync/atomic"
 	"time"
 )
 
+var (
+	// ErrNetworkByteLimitReached is returned before lower-level I/O whenever
+	// the active aggregate protocol-byte budget cannot admit the operation.
+	ErrNetworkByteLimitReached = errors.New("aggregate protocol byte limit reached")
+	ErrNetworkByteBudgetActive = errors.New("an aggregate protocol byte budget is already active")
+	ErrNetworkByteBudgetOwner  = errors.New("aggregate protocol byte budget owner mismatch")
+)
+
+// NetworkByteBudgetToken identifies the sole owner allowed to inspect and
+// clear one process-global aggregate protocol-byte budget.
+type NetworkByteBudgetToken uint64
+
+// NetworkByteBudgetSnapshot is a stable projection of actual protocol bytes
+// completed by the counting readers and writers owned by a budget.
+type NetworkByteBudgetSnapshot struct {
+	Limited    bool
+	LimitBytes int64
+	UsedBytes  int64
+	Exhausted  bool
+}
+
+type networkByteBudget struct {
+	owner NetworkByteBudgetToken
+
+	// gate permits concurrent I/O but makes ClearNetworkByteBudget a real
+	// drain boundary. Once closed, a stale connection cannot reach lower I/O.
+	gate   sync.RWMutex
+	closed bool
+
+	limited   bool
+	limit     int64
+	reserved  atomic.Int64
+	used      atomic.Int64
+	exhausted atomic.Bool
+}
+
+var (
+	activeNetworkByteBudget atomic.Pointer[networkByteBudget]
+	nextNetworkBudgetOwner  atomic.Uint64
+)
+
+// InstallNetworkByteBudget installs the one active aggregate budget. A limit
+// of -1 is unlimited but still session-scoped and counted; nonnegative values
+// are hard sent-plus-received byte limits.
+func InstallNetworkByteBudget(limit int64) (NetworkByteBudgetToken, error) {
+	if limit < -1 {
+		return 0, errors.New("aggregate protocol byte limit must be -1 or nonnegative")
+	}
+	owner := NetworkByteBudgetToken(nextNetworkBudgetOwner.Add(1))
+	if owner == 0 {
+		owner = NetworkByteBudgetToken(nextNetworkBudgetOwner.Add(1))
+	}
+	budget := &networkByteBudget{
+		owner:   owner,
+		limited: limit >= 0,
+		limit:   max(limit, 0),
+	}
+	if !activeNetworkByteBudget.CompareAndSwap(nil, budget) {
+		return 0, ErrNetworkByteBudgetActive
+	}
+	return owner, nil
+}
+
+// NetworkByteBudgetStatus returns the active owner's actual completed byte
+// count. In-flight reservations may make Exhausted true before UsedBytes
+// reaches LimitBytes, but after runtime drain UsedBytes is exact.
+func NetworkByteBudgetStatus(owner NetworkByteBudgetToken) (NetworkByteBudgetSnapshot, error) {
+	budget := activeNetworkByteBudget.Load()
+	if budget == nil || owner == 0 || budget.owner != owner {
+		return NetworkByteBudgetSnapshot{}, ErrNetworkByteBudgetOwner
+	}
+	budget.gate.RLock()
+	defer budget.gate.RUnlock()
+	if budget.closed || activeNetworkByteBudget.Load() != budget {
+		return NetworkByteBudgetSnapshot{}, ErrNetworkByteBudgetOwner
+	}
+	return budget.snapshot(), nil
+}
+
+// ClearNetworkByteBudget waits for all budgeted lower I/O to return, prevents
+// stale connections from issuing any later I/O, and clears only the matching
+// owner. A stale token can never clear a newer budget.
+func ClearNetworkByteBudget(owner NetworkByteBudgetToken) (NetworkByteBudgetSnapshot, error) {
+	budget := activeNetworkByteBudget.Load()
+	if budget == nil || owner == 0 || budget.owner != owner {
+		return NetworkByteBudgetSnapshot{}, ErrNetworkByteBudgetOwner
+	}
+	budget.gate.Lock()
+	defer budget.gate.Unlock()
+	if budget.closed || budget.owner != owner || activeNetworkByteBudget.Load() != budget {
+		return NetworkByteBudgetSnapshot{}, ErrNetworkByteBudgetOwner
+	}
+	budget.closed = true
+	if !activeNetworkByteBudget.CompareAndSwap(budget, nil) {
+		return NetworkByteBudgetSnapshot{}, ErrNetworkByteBudgetOwner
+	}
+	return budget.snapshot(), nil
+}
+
+func (b *networkByteBudget) snapshot() NetworkByteBudgetSnapshot {
+	exhausted := false
+	if b.limited {
+		exhausted = b.exhausted.Load() || b.reserved.Load() >= b.limit
+	}
+	return NetworkByteBudgetSnapshot{
+		Limited:    b.limited,
+		LimitBytes: b.limit,
+		UsedBytes:  b.used.Load(),
+		Exhausted:  exhausted,
+	}
+}
+
+func (b *networkByteBudget) begin() error {
+	b.gate.RLock()
+	if b.closed {
+		b.gate.RUnlock()
+		return ErrNetworkByteLimitReached
+	}
+	return nil
+}
+
+func (b *networkByteBudget) end() {
+	b.gate.RUnlock()
+}
+
+func (b *networkByteBudget) reserveWriter(bytes int64) error {
+	if bytes == 0 || !b.limited {
+		return nil
+	}
+	if b.exhausted.Load() {
+		return ErrNetworkByteLimitReached
+	}
+	for {
+		reserved := b.reserved.Load()
+		if bytes > b.limit-reserved {
+			b.exhausted.Store(true)
+			return ErrNetworkByteLimitReached
+		}
+		if b.reserved.CompareAndSwap(reserved, reserved+bytes) {
+			if b.exhausted.Load() {
+				b.reserved.Add(-bytes)
+				return ErrNetworkByteLimitReached
+			}
+			return nil
+		}
+	}
+}
+
+func (b *networkByteBudget) reserveReader(requested int64) (int64, error) {
+	if requested == 0 || !b.limited {
+		return requested, nil
+	}
+	if b.exhausted.Load() {
+		return 0, ErrNetworkByteLimitReached
+	}
+	for {
+		reserved := b.reserved.Load()
+		remaining := b.limit - reserved
+		if remaining <= 0 {
+			b.exhausted.Store(true)
+			return 0, ErrNetworkByteLimitReached
+		}
+		reservation := min(requested, remaining)
+		if b.reserved.CompareAndSwap(reserved, reserved+reservation) {
+			if b.exhausted.Load() {
+				b.reserved.Add(-reservation)
+				return 0, ErrNetworkByteLimitReached
+			}
+			return reservation, nil
+		}
+	}
+}
+
+func (b *networkByteBudget) finish(reserved, actual int64) {
+	if actual < 0 {
+		actual = 0
+	}
+	if actual > reserved {
+		actual = reserved
+	}
+	if b.limited {
+		b.reserved.Add(-(reserved - actual))
+	}
+	b.used.Add(actual)
+}
+
 type countingReader struct {
 	io.Reader
 
 	idString string
 	tot      atomic.Int64 // bytes
 	last     atomic.Int64 // unix nanos
+	budget   *networkByteBudget
 }
 
