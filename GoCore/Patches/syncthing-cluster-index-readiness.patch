+package syncthing
+
+import (
+	"testing"
+	"time"
+
+	"github.com/syncthing/syncthing/lib/model"
+	modelmocks "github.com/syncthing/syncthing/lib/model/mocks"
+	"github.com/syncthing/syncthing/lib/protocol"
+)
+
+func TestInternalsConnectionStatisticsProjectsOnlyConnectedCounters(t *testing.T) {
+	connectedID := protocol.NewDeviceID([]byte("connected statistics peer"))
+	disconnectedID := protocol.NewDeviceID([]byte("disconnected statistics peer"))
+	startedAt := time.Unix(1_700_000_000, 0).UTC()
+	at := startedAt.Add(10 * time.Second)
+
+	fakeModel := new(modelmocks.Model)
+	fakeModel.ConnectionStatsReturns(map[string]interface{}{
+		"connections": map[string]model.ConnectionStats{
+			connectedID.String(): {
+				Connected: true,
+				Statistics: protocol.Statistics{
+					At:            at,
+					StartedAt:     startedAt,
+					InBytesTotal:  123,
+					OutBytesTotal: 456,
+				},
+				Secondary: []model.ConnectionInfo{{}},
+			},
+			disconnectedID.String(): {Connected: false},
+			"not-a-device-id":       {Connected: true},
+		},
+	})
+
+	statistics := newInternals(fakeModel).ConnectionStatistics()
+	if len(statistics) != 1 {
+		t.Fatalf("projected statistics = %+v, want exactly one connected peer", statistics)
+	}
+	got, ok := statistics[connectedID]
+	if !ok {
+		t.Fatalf("connected peer is missing: %+v", statistics)
+	}
+	if got.At != at || got.StartedAt != startedAt || got.InBytesTotal != 123 || got.OutBytesTotal != 456 || got.Connections != 2 {
+		t.Fatalf("projected counters = %+v", got)
+	}
+}
