+	reserved := int64(len(bs))
+	if c.budget != nil {
+		if err := c.budget.begin(); err != nil {
+			return 0, err
+		}
+		defer c.budget.end()
+		var err error
+		reserved, err = c.budget.reserveReader(reserved)
+		if err != nil {
+			return 0, err
+		}
+		bs = bs[:reserved]
+	}
 	n, err := c.Reader.Read(bs)
+	if c.budget != nil {
+		c.budget.finish(reserved, int64(n))
+	}
 	c.tot.Add(int64(n))
 	totalIncoming.Add(int64(n))
 	c.last.Store(time.Now().UnixNano())
@@ -46,10 +251,24 @@ type countingWriter struct {
 	idString string
 	tot      atomic.Int64 // bytes
 	last     atomic.Int64 // unix nanos
+	budget   *networkByteBudget
 }
 
 func (c *countingWriter) Write(bs []byte) (int, error) {
+	reserved := int64(len(bs))
+	if c.budget != nil {
+		if err := c.budget.begin(); err != nil {
+			return 0, err
+		}
+		defer c.budget.end()
+		if err := c.budget.reserveWriter(reserved); err != nil {
+			return 0, err
+		}
+	}
 	n, err := c.Writer.Write(bs)
+	if c.budget != nil {
+		c.budget.finish(reserved, int64(n))
+	}
 	c.tot.Add(int64(n))
 	totalOutgoing.Add(int64(n))
 	c.last.Store(time.Now().UnixNano())
diff --git a/.build/go/syncthing-readiness-v1/lib/protocol/counting_budget_test.go b/lib/protocol/counting_budget_test.go
new file mode 100644
index 0000000..fac8279
--- /dev/null
+++ b/lib/protocol/counting_budget_test.go
@@ -0,0 +1,242 @@
+// Copyright (C) 2026 The Syncthing Authors.
+//
+// This Source Code Form is subject to the terms of the Mozilla Public
+// License, v. 2.0. If a copy of the MPL was not distributed with this file,
+// You can obtain one at https://mozilla.org/MPL/2.0/.
+
+package protocol
+
+import (
+	"bytes"
+	"errors"
+	"io"
+	"sync"
+	"testing"
+)
+
+func TestNetworkByteBudgetWriterHardLimitAndRefund(t *testing.T) {
+	t.Run("zero", func(t *testing.T) {
+		owner := installNetworkByteBudgetForTest(t, 0)
+		var destination bytes.Buffer
+		writer := &countingWriter{Writer: &destination, budget: activeNetworkByteBudget.Load()}
+		if written, err := writer.Write([]byte("x")); written != 0 || !errors.Is(err, ErrNetworkByteLimitReached) {
+			t.Fatalf("zero-limit write = (%d, %v), want (0, limit)", written, err)
+		}
+		if destination.Len() != 0 {
+			t.Fatal("zero-limit writer reached lower I/O")
+		}
+		status := clearNetworkByteBudgetForTest(t, owner)
+		if !status.Limited || status.LimitBytes != 0 || status.UsedBytes != 0 || !status.Exhausted {
+			t.Fatalf("zero-limit status = %+v", status)
+		}
+	})
+
+	t.Run("exact boundary", func(t *testing.T) {
+		owner := installNetworkByteBudgetForTest(t, 5)
+		var destination bytes.Buffer
+		writer := &countingWriter{Writer: &destination, budget: activeNetworkByteBudget.Load()}
+		for _, data := range [][]byte{[]byte("abc"), []byte("de")} {
+			if written, err := writer.Write(data); written != len(data) || err != nil {
+				t.Fatalf("boundary write = (%d, %v), want (%d, nil)", written, err, len(data))
+			}
+		}
+		if written, err := writer.Write([]byte("f")); written != 0 || !errors.Is(err, ErrNetworkByteLimitReached) {
+			t.Fatalf("post-boundary write = (%d, %v), want (0, limit)", written, err)
+		}
+		status := clearNetworkByteBudgetForTest(t, owner)
+		if status.UsedBytes != 5 || !status.Exhausted || destination.String() != "abcde" {
+			t.Fatalf("boundary result status=%+v destination=%q", status, destination.String())
+		}
+	})
+
+	t.Run("whole write and sticky exhaustion", func(t *testing.T) {
+		owner := installNetworkByteBudgetForTest(t, 10)
+		var destination bytes.Buffer
+		writer := &countingWriter{Writer: &destination, budget: activeNetworkByteBudget.Load()}
+		if written, err := writer.Write([]byte("123456")); written != 6 || err != nil {
+			t.Fatalf("initial write = (%d, %v)", written, err)
+		}
+		if written, err := writer.Write([]byte("12345")); written != 0 || !errors.Is(err, ErrNetworkByteLimitReached) {
+			t.Fatalf("overlarge write = (%d, %v), want hard rejection", written, err)
+		}
+		if written, err := writer.Write([]byte("1234")); written != 0 || !errors.Is(err, ErrNetworkByteLimitReached) {
+			t.Fatalf("post-exhaustion fitting write = (%d, %v), want sticky rejection", written, err)
+		}
+		status := clearNetworkByteBudgetForTest(t, owner)
+		if status.UsedBytes != 6 || !status.Exhausted || destination.String() != "123456" {
+			t.Fatalf("sticky result status=%+v destination=%q", status, destination.String())
+		}
+	})
+
+	t.Run("partial and error refund", func(t *testing.T) {
+		owner := installNetworkByteBudgetForTest(t, 6)
+		destination := &boundedTestWriter{maximum: 2, err: io.ErrUnexpectedEOF}
+		writer := &countingWriter{Writer: destination, budget: activeNetworkByteBudget.Load()}
+		if written, err := writer.Write([]byte("abcd")); written != 2 || !errors.Is(err, io.ErrUnexpectedEOF) {
+			t.Fatalf("partial write = (%d, %v)", written, err)
+		}
+		destination.maximum = 4
+		destination.err = nil
+		if written, err := writer.Write([]byte("cdef")); written != 4 || err != nil {
+			t.Fatalf("refunded write = (%d, %v)", written, err)
+		}
+		status := clearNetworkByteBudgetForTest(t, owner)
+		if status.UsedBytes != 6 || destination.buffer.String() != "abcdef" {
+			t.Fatalf("refund result status=%+v destination=%q", status, destination.buffer.String())
+		}
+	})
+}
+
+func TestNetworkByteBudgetReaderCapsAndRefunds(t *testing.T) {
+	owner := installNetworkByteBudgetForTest(t, 4)
+	source := &boundedTestReader{reader: bytes.NewReader([]byte("abcdef")), maximum: 1}
+	reader := &countingReader{Reader: source, budget: activeNetworkByteBudget.Load()}
+	buffer := make([]byte, 6)
+	if read, err := reader.Read(buffer); read != 1 || err != nil {
+		t.Fatalf("partial read = (%d, %v)", read, err)
+	}
+	source.maximum = 8
+	if read, err := reader.Read(buffer[1:]); read != 3 || err != nil {
+		t.Fatalf("remaining read = (%d, %v), want (3, nil)", read, err)
+	}
+	if read, err := reader.Read(buffer); read != 0 || !errors.Is(err, ErrNetworkByteLimitReached) {
+		t.Fatalf("post-limit read = (%d, %v), want (0, limit)", read, err)
+	}
+	status := clearNetworkByteBudgetForTest(t, owner)
+	if status.UsedBytes != 4 || !status.Exhausted || string(buffer[:4]) != "abcd" {
+		t.Fatalf("reader result status=%+v data=%q", status, buffer[:4])
+	}
+
+	owner = installNetworkByteBudgetForTest(t, 4)
+	budget := activeNetworkByteBudget.Load()
+	eofSource := &boundedTestReader{reader: bytes.NewReader([]byte("z")), maximum: 4, err: io.EOF}
+	eofReader := &countingReader{Reader: eofSource, budget: budget}
+	if read, err := eofReader.Read(buffer[:4]); read != 1 || !errors.Is(err, io.EOF) {
+		t.Fatalf("EOF read = (%d, %v), want (1, EOF)", read, err)
+	}
+	writer := &countingWriter{Writer: io.Discard, budget: budget}
+	if written, err := writer.Write([]byte("123")); written != 3 || err != nil {
+		t.Fatalf("write after EOF refund = (%d, %v), want (3, nil)", written, err)
+	}
+	status = clearNetworkByteBudgetForTest(t, owner)
+	if status.UsedBytes != 4 {
+		t.Fatalf("EOF refund status = %+v", status)
+	}
+}
+
+func TestNetworkByteBudgetConcurrentAggregateNeverOvershoots(t *testing.T) {
+	const limit = int64(4096)
+	owner := installNetworkByteBudgetForTest(t, limit)
+	budget := activeNetworkByteBudget.Load()
+	start := make(chan struct{})
+	var group sync.WaitGroup
+	for index := 0; index < 24; index++ {
+		group.Add(1)
+		go func(reader bool) {
+			defer group.Done()
+			<-start
+			if reader {
+				wrapped := &countingReader{Reader: bytes.NewReader(make([]byte, 8192)), budget: budget}
+				buffer := make([]byte, 37)
+				for {
+					if _, err := wrapped.Read(buffer); err != nil {
+						return
+					}
+				}
+			}
+			wrapped := &countingWriter{Writer: io.Discard, budget: budget}
+			for {
+				if _, err := wrapped.Write(make([]byte, 31)); err != nil {
+					return
+				}
+			}
+		}(index%2 == 0)
+	}
+	close(start)
+	group.Wait()
+	status := clearNetworkByteBudgetForTest(t, owner)
+	if status.UsedBytes > limit {
+		t.Fatalf("concurrent aggregate overshot: %+v", status)
+	}
+	if !status.Exhausted {
+		t.Fatalf("concurrent aggregate did not reach sticky exhaustion: %+v", status)
+	}
+}
+
+func TestNetworkByteBudgetOwnerTokenAndUnlimitedAccounting(t *testing.T) {
+	first := installNetworkByteBudgetForTest(t, -1)
+	if _, err := InstallNetworkByteBudget(1); !errors.Is(err, ErrNetworkByteBudgetActive) {
+		t.Fatalf("second install error = %v, want active", err)
+	}
+	budget := activeNetworkByteBudget.Load()
+	writer := &countingWriter{Writer: io.Discard, budget: budget}
+	reader := &countingReader{Reader: bytes.NewReader([]byte("world")), budget: budget}
+	if _, err := writer.Write([]byte("hello")); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := reader.Read(make([]byte, 5)); err != nil {
+		t.Fatal(err)
+	}
+	firstStatus := clearNetworkByteBudgetForTest(t, first)
+	if firstStatus.Limited || firstStatus.LimitBytes != 0 || firstStatus.UsedBytes != 10 || firstStatus.Exhausted {
+		t.Fatalf("unlimited status = %+v", firstStatus)
+	}
+
+	second := installNetworkByteBudgetForTest(t, 1)
+	if _, err := ClearNetworkByteBudget(first); !errors.Is(err, ErrNetworkByteBudgetOwner) {
+		t.Fatalf("stale clear error = %v, want owner mismatch", err)
+	}
+	if _, err := NetworkByteBudgetStatus(first); !errors.Is(err, ErrNetworkByteBudgetOwner) {
+		t.Fatalf("stale status error = %v, want owner mismatch", err)
+	}
+	clearNetworkByteBudgetForTest(t, second)
+}
+
+type boundedTestWriter struct {
+	buffer  bytes.Buffer
+	maximum int
+	err     error
+}
+
+func (w *boundedTestWriter) Write(data []byte) (int, error) {
+	if len(data) > w.maximum {
+		data = data[:w.maximum]
+	}
+	written, _ := w.buffer.Write(data)
+	return written, w.err
+}
+
+type boundedTestReader struct {
+	reader  *bytes.Reader
+	maximum int
+	err     error
+}
+
+func (r *boundedTestReader) Read(buffer []byte) (int, error) {
+	if len(buffer) > r.maximum {
+		buffer = buffer[:r.maximum]
+	}
+	read, err := r.reader.Read(buffer)
+	if r.err != nil {
+		err = r.err
+	}
+	return read, err
+}
+
+func installNetworkByteBudgetForTest(t *testing.T, limit int64) NetworkByteBudgetToken {
+	t.Helper()
+	owner, err := InstallNetworkByteBudget(limit)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return owner
+}
+
+func clearNetworkByteBudgetForTest(t *testing.T, owner NetworkByteBudgetToken) NetworkByteBudgetSnapshot {
+	t.Helper()
+	status, err := ClearNetworkByteBudget(owner)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return status
+}
