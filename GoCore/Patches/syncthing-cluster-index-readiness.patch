@@ -0,0 +1,83 @@
+// Copyright (C) 2026 The Syncthing Authors.
+//
+// This Source Code Form is subject to the terms of the Mozilla Public
+// License, v. 2.0. If a copy of the MPL was not distributed with this file,
+// You can obtain one at https://mozilla.org/MPL/2.0/.
+
+package model
+
+import (
+	"testing"
+
+	"github.com/syncthing/syncthing/lib/protocol"
+)
+
+func TestLocalDatalessRetainsGlobalMetadataWithoutSourceAuthority(t *testing.T) {
+	m, conn, folder := setupModelWithConnection(t)
+	filesystem := folder.Filesystem()
+	defer cleanupModelAndRemoveDir(m, filesystem.URI())
+
+	const name = "kept-as-placeholder.txt"
+	writeFile(t, filesystem, name, []byte("verified contents"))
+	must(t, m.ScanFolder(folder.ID))
+	local, ok := m.testCurrentFolderFile(folder.ID, name)
+	if !ok {
+		t.Fatal("local file was not indexed")
+	}
+	must(t, m.IndexUpdate(conn, indexUpdateForTest(t, m, conn, folder.ID, []protocol.FileInfo{local})))
+
+	holders, err := m.GlobalFileAvailability(folder.ID, name)
+	if err != nil || len(holders) != 1 || holders[0] != conn.DeviceID() {
+		t.Fatalf("unexpected exact remote availability: %v, %v", holders, err)
+	}
+	must(t, m.SetLocalContentUnavailable(folder.ID, name, local.Version.String()))
+
+	dataless, ok, err := m.sdb.GetDeviceFile(folder.ID, protocol.LocalDeviceID, name)
+	if err != nil || !ok || !dataless.IsDataless() || !dataless.IsInvalid() {
+		t.Fatalf("local item did not become invalid dataless metadata: %+v, %v", dataless, err)
+	}
+	availability, err := m.sdb.GetGlobalAvailability(folder.ID, name)
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, deviceID := range availability {
+		if deviceID == protocol.LocalDeviceID {
+			t.Fatal("dataless local item remained a global source")
+		}
+	}
+	completion, err := m.folderCompletion(protocol.LocalDeviceID, folder.ID)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if completion.NeedItems != 0 || completion.NeedBytes != 0 {
+		t.Fatalf("intentional dataless content remained an automatic download need: %+v", completion)
+	}
+
+	must(t, filesystem.Remove(name))
+	must(t, m.ScanFolder(folder.ID))
+	afterRemoval, ok, err := m.sdb.GetDeviceFile(folder.ID, protocol.LocalDeviceID, name)
+	if err != nil || !ok || !afterRemoval.IsDataless() || afterRemoval.IsDeleted() {
+		t.Fatalf("scanner converted dataless absence into deletion: %+v, %v", afterRemoval, err)
+	}
+
+	writeFile(t, filesystem, name, []byte("leftover bytes"))
+	must(t, m.ScanFolder(folder.ID))
+	afterLeftover, ok, err := m.sdb.GetDeviceFile(folder.ID, protocol.LocalDeviceID, name)
+	if err != nil || !ok || !afterLeftover.IsDataless() {
+		t.Fatalf("scanner restored source authority from leftover bytes: %+v, %v", afterLeftover, err)
+	}
+	if err := m.SetLocalContentAvailable(folder.ID, name, local.Version.String(), true); err == nil {
+		t.Fatal("wrong leftover bytes were accepted as the exact global version")
+	}
+	stillDataless, ok, err := m.sdb.GetDeviceFile(folder.ID, protocol.LocalDeviceID, name)
+	if err != nil || !ok || !stillDataless.IsDataless() {
+		t.Fatalf("failed availability proof changed dataless authority: %+v, %v", stillDataless, err)
+	}
+
+	writeFile(t, filesystem, name, []byte("verified contents"))
+	must(t, m.SetLocalContentAvailable(folder.ID, name, local.Version.String(), true))
+	materialized, ok, err := m.sdb.GetDeviceFile(folder.ID, protocol.LocalDeviceID, name)
+	if err != nil || !ok || materialized.IsDataless() || !materialized.IsOnDemand() || materialized.IsInvalid() {
+		t.Fatalf("verified on-demand bytes did not become a local source: %+v, %v", materialized, err)
+	}
+}
