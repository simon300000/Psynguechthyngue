+func TestClusterConfigObservationEvidenceIsPrivateJSON(t *testing.T) {
+	deviceID := protocol.NewDeviceID([]byte("private cluster config observation"))
+	data := ClusterConfigReceivedEventData{
+		Device:          deviceID,
+		ConnectionID:    "raw-connection-identity-must-not-escape",
+		ConnectionEpoch: 42,
+		PendingFolders: []PendingFolderObservation{{
+			FolderID: "private-folder",
+			Label:    "Private offer",
+			LastSeen: time.Now().UTC(),
+		}},
+	}
+	encoded, err := json.Marshal(data)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if strings.Contains(string(encoded), "raw-connection") || strings.Contains(string(encoded), "private-folder") || strings.Contains(string(encoded), "connectionEpoch") {
+		t.Fatalf("private ClusterConfig evidence escaped event JSON: %s", encoded)
+	}
+	var public map[string]any
+	if err := json.Unmarshal(encoded, &public); err != nil {
+		t.Fatal(err)
+	}
+	if len(public) != 1 || public["device"] == nil {
+		t.Fatalf("ClusterConfig public event ABI changed: %#v", public)
+	}
+}
+
+func TestStaleEpochCannotPublishPendingFolderObservationCallback(t *testing.T) {
+	deviceID := protocol.NewDeviceID([]byte("stale observation epoch"))
+	proofs := newRemoteIndexProofState(nil)
+	stale := proofs.begin(deviceID, "connection-one")
+	current, ok := proofs.rotate(stale)
+	if !ok {
+		t.Fatal("could not rotate the current observation epoch")
+	}
+	staleCalled := false
+	if proofs.publishAndDo(stale, nil, func() { staleCalled = true }) || staleCalled {
+		t.Fatal("stale ClusterConfig epoch published observation evidence")
+	}
+	currentCalled := false
+	if !proofs.publishAndDo(current, nil, func() { currentCalled = true }) || !currentCalled {
+		t.Fatal("current ClusterConfig epoch did not publish observation evidence")
+	}
+}
+
+func TestPendingFolderObservationEpochMustRemainCurrentReceiveOwner(t *testing.T) {
+	t.Run("published then closed", func(t *testing.T) {
+		wrapper, folder := newDefaultCfgWrapper(t)
+		m := setupModel(t, wrapper)
+		defer cleanupModel(m)
+
+		connection := newFakeConnection(device1, m)
+		m.AddConnection(connection, protocol.Hello{})
+		m.promoteConnections()
+		mustReceiveProofClusterConfig(t, m, connection, folder.ID, 101, 0)
+		published := mustRemoteIndexReadiness(t, m, device1, folder.ID)
+		if !m.RemoteIndexEpochCurrent(device1, published.ConnectionID, published.ConnectionEpoch) {
+			t.Fatal("freshly published receive-owner epoch was not current")
+		}
+
+		m.Closed(connection, errors.New("closed after publication"))
+		if m.RemoteIndexEpochCurrent(device1, published.ConnectionID, published.ConnectionEpoch) {
+			t.Fatal("closed receive-owner epoch remained current")
+		}
+	})
+
+	t.Run("replacement starts without successful ClusterConfig", func(t *testing.T) {
+		wrapper, folder := newDefaultCfgWrapper(t)
+		m := setupModel(t, wrapper)
+		defer cleanupModel(m)
+
+		first := newFakeConnection(device1, m)
+		m.AddConnection(first, protocol.Hello{})
+		m.promoteConnections()
+		mustReceiveProofClusterConfig(t, m, first, folder.ID, 102, 0)
+		published := mustRemoteIndexReadiness(t, m, device1, folder.ID)
+
+		replacement := newFakeConnection(device1, m)
+		m.AddConnection(replacement, protocol.Hello{})
+		if _, _, err := m.ensureIndexHandler(replacement); err != nil {
+			t.Fatal(err)
+		}
+		if m.RemoteIndexEpochCurrent(device1, published.ConnectionID, published.ConnectionEpoch) {
+			t.Fatal("replaced receive-owner epoch remained current before a new ClusterConfig was published")
+		}
+	})
+
+	t.Run("same connection rotates", func(t *testing.T) {
+		wrapper, folder := newDefaultCfgWrapper(t)
+		m := setupModel(t, wrapper)
+		defer cleanupModel(m)
+
+		connection := newFakeConnection(device1, m)
+		m.AddConnection(connection, protocol.Hello{})
+		m.promoteConnections()
+		mustReceiveProofClusterConfig(t, m, connection, folder.ID, 103, 0)
+		published := mustRemoteIndexReadiness(t, m, device1, folder.ID)
+
+		if _, _, err := m.ensureIndexHandler(connection); err != nil {
+			t.Fatal(err)
+		}
+		if m.RemoteIndexEpochCurrent(device1, published.ConnectionID, published.ConnectionEpoch) {
+			t.Fatal("retired same-connection epoch remained current")
+		}
+	})
+}
+
+func TestReplacementConnectionLogOmitsRawConnectionIDs(t *testing.T) {
+	wrapper, folder := newDefaultCfgWrapper(t)
+	m := setupModel(t, wrapper)
+	defer cleanupModel(m)
+
+	first := newFakeConnection(device1, m)
+	first.ConnectionIDReturns("raw-old-connection-log-sentinel")
+	m.AddConnection(first, protocol.Hello{})
+	m.promoteConnections()
+	mustReceiveProofClusterConfig(t, m, first, folder.ID, 104, 0)
+
+	replacement := newFakeConnection(device1, m)
+	replacement.ConnectionIDReturns("raw-new-connection-log-sentinel")
+	m.AddConnection(replacement, protocol.Hello{})
+
+	previous := slog.Default()
+	var output bytes.Buffer
+	slog.SetDefault(slog.New(slog.NewTextHandler(&output, nil)))
+	defer slog.SetDefault(previous)
+	if _, _, err := m.ensureIndexHandler(replacement); err != nil {
+		t.Fatal(err)
+	}
+	rendered := output.String()
+	if !strings.Contains(rendered, "Abandoning old index handler in favour of new connection") {
+		t.Fatalf("replacement logging seam was not exercised: %q", rendered)
+	}
+	if strings.Contains(rendered, "raw-old-connection") || strings.Contains(rendered, "raw-new-connection") {
+		t.Fatalf("replacement log exposed a raw connection ID: %q", rendered)
+	}
+}
