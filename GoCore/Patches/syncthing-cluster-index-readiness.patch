+
+func TestInternalConnectionLoggingOmitsRawConnectionID(t *testing.T) {
+	client, server := net.Pipe()
+	defer client.Close()
+	defer server.Close()
+
+	connection := newInternalConn(tls.Client(client, &tls.Config{InsecureSkipVerify: true}), connTypeTCPClient, true, 10)
+	rawConnectionID := "raw-connection-id-log-sentinel"
+	connection.connectionID = rawConnectionID
+
+	if rendered := connection.String(); strings.Contains(rendered, rawConnectionID) {
+		t.Fatalf("connection String exposed the raw connection ID: %q", rendered)
+	}
+	var output bytes.Buffer
+	slog.New(slog.NewTextHandler(&output, nil)).Info("Established secure connection", slog.Any("connection", connection))
+	if rendered := output.String(); strings.Contains(rendered, rawConnectionID) {
+		t.Fatalf("connection LogValue exposed the raw connection ID: %q", rendered)
+	}
+}
