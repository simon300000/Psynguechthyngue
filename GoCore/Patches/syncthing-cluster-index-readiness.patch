+			if err := m.IndexUpdate(replacement, &protocol.IndexUpdate{
+				Folder:       folder.ID,
+				Files:        []protocol.FileInfo{later},
+				PrevSequence: 5,
+				LastSequence: 11,
+			}); err != nil {
+				t.Fatal(err)
+			}
+			if got := mustRemoteIndexReadiness(t, m, device1, folder.ID); got.State != RemoteIndexProofCurrent || got.StoredSequence != 11 {
+				t.Fatalf("fresh connection did not recover from the poisoned epoch: %+v", got)
+			}
+		})
+	}
+}
+
+func TestRemoteIndexProofRejectsEqualityReplay(t *testing.T) {
+	wrapper, folder := newDefaultCfgWrapper(t)
+	m := setupModel(t, wrapper)
+	defer cleanupModel(m)
+
+	const indexID = protocol.IndexID(103)
+	if err := m.sdb.SetIndexID(folder.ID, device1, indexID); err != nil {
+		t.Fatal(err)
+	}
+	seed := protocol.FileInfo{Name: "original", Sequence: 11, Version: protocol.Vector{}.Update(device1.Short())}
+	if err := m.sdb.Update(folder.ID, device1, []protocol.FileInfo{seed}); err != nil {
+		t.Fatal(err)
+	}
+	connection := newFakeConnection(device1, m)
+	m.AddConnection(connection, protocol.Hello{})
+	m.promoteConnections()
+	mustReceiveProofClusterConfig(t, m, connection, folder.ID, indexID, 11)
+	if got := mustRemoteIndexReadiness(t, m, device1, folder.ID); got.State != RemoteIndexProofCurrent {
+		t.Fatalf("test setup did not establish current proof: %+v", got)
+	}
+
+	replay := protocol.FileInfo{Name: "replacement", Sequence: 11, Version: protocol.Vector{}.Update(device1.Short())}
+	if err := m.IndexUpdate(connection, &protocol.IndexUpdate{
+		Folder:       folder.ID,
+		Files:        []protocol.FileInfo{replay},
+		PrevSequence: 11,
+		LastSequence: 11,
+	}); !errors.Is(err, errInvalidRemoteIndexEpoch) {
+		t.Fatalf("replay error = %v, want invalid-epoch sentinel", err)
+	}
+	if got := mustRemoteIndexReadiness(t, m, device1, folder.ID); got.State != RemoteIndexProofPending {
+		t.Fatalf("equal-sequence replay preserved a current proof: %+v", got)
+	}
+}
+
+func TestRemoteIndexProofRejectsZeroSequenceFullFrame(t *testing.T) {
+	wrapper, folder := newDefaultCfgWrapper(t)
+	m := setupModel(t, wrapper)
+	defer cleanupModel(m)
+
+	connection := newFakeConnection(device1, m)
+	m.AddConnection(connection, protocol.Hello{})
+	m.promoteConnections()
+	mustReceiveProofClusterConfig(t, m, connection, folder.ID, 0, 0)
+	zero := protocol.FileInfo{Name: "zero", Sequence: 0, Version: protocol.Vector{}.Update(device1.Short())}
+	if err := m.Index(connection, &protocol.Index{Folder: folder.ID, Files: []protocol.FileInfo{zero}}); !errors.Is(err, errInvalidRemoteIndexEpoch) {
+		t.Fatalf("zero-sequence error = %v, want invalid-epoch sentinel", err)
+	}
+	if got := mustRemoteIndexReadiness(t, m, device1, folder.ID); got.State != RemoteIndexProofPending {
+		t.Fatalf("zero-sequence full frame completed proof: %+v", got)
+	}
+	if err := m.Index(connection, &protocol.Index{Folder: folder.ID}); !errors.Is(err, errInvalidRemoteIndexEpoch) {
+		t.Fatalf("later frame error = %v, want invalid-epoch sentinel", err)
+	}
+	if got := mustRemoteIndexReadiness(t, m, device1, folder.ID); got.State != RemoteIndexProofPending {
+		t.Fatalf("later valid frame repaired zero-sequence epoch: %+v", got)
+	}
+}
+
+func mustReceiveProofClusterConfig(t *testing.T, m *testModel, connection protocol.Connection, folder string, indexID protocol.IndexID, maxSequence int64) {
+	t.Helper()
+	if err := m.ClusterConfig(connection, &protocol.ClusterConfig{Folders: []protocol.Folder{{
+		ID: folder,
+		Devices: []protocol.Device{
+			{ID: myID},
+			{ID: device1, IndexID: indexID, MaxSequence: maxSequence},
+		},
+	}}}); err != nil {
+		t.Fatal(err)
+	}
+}
+
+func mustRemoteIndexReadiness(t *testing.T, m *testModel, device protocol.DeviceID, folder string) RemoteIndexReadiness {
+	t.Helper()
+	readiness, err := m.RemoteIndexReadiness(device, folder)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return readiness
+}
