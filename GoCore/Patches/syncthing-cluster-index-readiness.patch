+func TestAtomicIndexIDAndSequence(t *testing.T) {
+	database, err := Open(t.TempDir())
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() {
+		if err := database.Close(); err != nil {
+			t.Fatal(err)
+		}
+	})
+
+	device := protocol.DeviceID{42}
+	indexID, sequence, err := database.GetIndexIDAndSequence("missing", device)
+	if err != nil || indexID != 0 || sequence != 0 {
+		t.Fatalf("missing folder pair = (%v, %d, %v), want (0, 0, nil)", indexID, sequence, err)
+	}
+
+	const folder = "atomic-index-pair"
+	indexID, sequence, err = database.GetIndexIDAndSequence(folder, device)
+	if err != nil || indexID != 0 || sequence != 0 {
+		t.Fatalf("missing device pair = (%v, %d, %v), want (0, 0, nil)", indexID, sequence, err)
+	}
+
+	const firstIndexID = protocol.IndexID(101)
+	if err := database.SetIndexID(folder, device, firstIndexID); err != nil {
+		t.Fatal(err)
+	}
+	file := genFile("indexed", 1, 73)
+	file.Version = file.Version.Update(42)
+	if err := database.Update(folder, device, []protocol.FileInfo{file}); err != nil {
+		t.Fatal(err)
+	}
+	indexID, sequence, err = database.GetIndexIDAndSequence(folder, device)
+	if err != nil || indexID != firstIndexID || sequence != 73 {
+		t.Fatalf("stored pair = (%v, %d, %v), want (%v, 73, nil)", indexID, sequence, err, firstIndexID)
+	}
+
+	const replacementIndexID = protocol.IndexID(202)
+	if err := database.SetIndexID(folder, device, replacementIndexID); err != nil {
+		t.Fatal(err)
+	}
+	indexID, sequence, err = database.GetIndexIDAndSequence(folder, device)
+	if err != nil || indexID != replacementIndexID || sequence != 0 {
+		t.Fatalf("reset pair = (%v, %d, %v), want (%v, 0, nil)", indexID, sequence, err, replacementIndexID)
+	}
+
+	zeroIDDevice := protocol.DeviceID{43}
+	zeroIDFile := genFile("zero-id", 1, 9)
+	zeroIDFile.Version = zeroIDFile.Version.Update(43)
+	if err := database.Update(folder, zeroIDDevice, []protocol.FileInfo{zeroIDFile}); err != nil {
+		t.Fatal(err)
+	}
+	indexID, sequence, err = database.GetIndexIDAndSequence(folder, zeroIDDevice)
+	if err != nil || indexID != 0 || sequence != 9 {
+		t.Fatalf("zero-ID pair = (%v, %d, %v), want (0, 9, nil)", indexID, sequence, err)
+	}
+}
