+func fullIndexForTest(folder string, files []protocol.FileInfo) *protocol.Index {
+	files, lastSequence := sequencedIndexFilesForTest(0, files)
+	return &protocol.Index{Folder: folder, Files: files, LastSequence: lastSequence}
+}
+
+func indexUpdateForTest(t testing.TB, m *testModel, conn protocol.Connection, folder string, files []protocol.FileInfo) *protocol.IndexUpdate {
+	t.Helper()
+	prevSequence, err := m.sdb.GetDeviceSequence(folder, conn.DeviceID())
+	if err != nil {
+		t.Fatal(err)
+	}
+	files, lastSequence := sequencedIndexFilesForTest(prevSequence, files)
+	return &protocol.IndexUpdate{
+		Folder:       folder,
+		Files:        files,
+		PrevSequence: prevSequence,
+		LastSequence: lastSequence,
+	}
+}
+
+func sequencedIndexFilesForTest(prevSequence int64, files []protocol.FileInfo) ([]protocol.FileInfo, int64) {
+	sequenced := append([]protocol.FileInfo(nil), files...)
+	lastSequence := prevSequence
+	for index := range sequenced {
+		if sequenced[index].Sequence <= lastSequence {
+			sequenced[index].Sequence = lastSequence + 1
+		}
+		lastSequence = sequenced[index].Sequence
+	}
+	return sequenced, lastSequence
+}
+
+func clusterConfigForTest(t testing.TB, m *testModel, device protocol.DeviceID, clusterConfig *protocol.ClusterConfig) error {
+	t.Helper()
+	m.mut.RLock()
+	connectionIDs := append([]string(nil), m.deviceConnIDs[device]...)
+	var connection protocol.Connection
+	if len(connectionIDs) > 0 {
+		connection = m.connections[connectionIDs[0]]
+	}
+	m.mut.RUnlock()
+	if connection == nil {
+		t.Fatalf("missing registered test connection for device %s", device.Short())
+	}
+	return m.ClusterConfig(connection, clusterConfig)
 }
 
